            <Box name="VideoBridge" id="2" localization="8" tooltip="Pepper video -> backend TCP" x="620" y="260">
              <bitmap>media/images/box/box-python-script.png</bitmap>
              <script language="4"><content><![CDATA[
import socket
import struct
import threading
import time

class MyClass(GeneratedClass):
    MAC_IP = "192.168.1.50"
    VIDEO_PORT = 5557

    CAMERA_ID = 0
    CAMERA_RESOLUTION = 1
    CAMERA_COLOR_SPACE = 11
    CAMERA_FPS = 8

    FRAME_HEADER_FMT = "<III"

    def __init__(self):
        GeneratedClass.__init__(self)
        self._running = False
        self._video_service = None
        self._sock = None
        self._video_handle = None
        self._thread = None
        self._last_reconnect = 0.0

    def onLoad(self):
        try:
            self._video_service = self.session().service("ALVideoDevice")
        except Exception as e:
            self.logger.error("VideoBridge init error: %s" % str(e))

    def onUnload(self):
        self._stop_video()

    def onInput_onStart(self):
        if self._running:
            return
        self._running = True
        self._connect_socket(True)
        self._start_video()

    def onInput_onStop(self):
        self._stop_video()
        self._close_socket()
        self._running = False
        self.onStopped()

    def _start_video(self):
        if not self._video_service:
            self.logger.error("VideoBridge: ALVideoDevice indisponible")
            return
        try:
            self._video_handle = self._video_service.subscribeCamera(
                self.getName() + "_cam",
                int(self.CAMERA_ID),
                int(self.CAMERA_RESOLUTION),
                int(self.CAMERA_COLOR_SPACE),
                int(self.CAMERA_FPS),
            )
            self._thread = threading.Thread(target=self._video_loop)
            self._thread.daemon = True
            self._thread.start()
            self.logger.info("VideoBridge subscribed")
        except Exception as e:
            self.logger.error("VideoBridge subscribe error: %s" % str(e))

    def _stop_video(self):
        if self._video_service and self._video_handle:
            try:
                self._video_service.unsubscribe(self._video_handle)
            except Exception:
                pass
        self._video_handle = None
        if self._thread and self._thread.is_alive():
            self._thread.join(1.5)
        self._thread = None

    def _video_loop(self):
        sleep_s = 1.0 / float(max(1, int(self.CAMERA_FPS)))
        while self._running:
            try:
                if not self._video_handle:
                    time.sleep(sleep_s)
                    continue
                frame = self._video_service.getImageRemote(self._video_handle)
                if not frame or len(frame) < 7:
                    time.sleep(sleep_s)
                    continue

                ts_sec = int(frame[4]) if frame[4] is not None else int(time.time())
                ts_usec = int(frame[5]) if frame[5] is not None else 0
                payload = frame[6]
                if payload:
                    self._send_frame(payload, ts_sec, ts_usec)
            except Exception:
                self._close_socket()
            time.sleep(sleep_s)

    def _send_frame(self, payload, ts_sec, ts_usec):
        try:
            self._connect_socket(False)
            if not self._sock:
                return
            header = struct.pack(self.FRAME_HEADER_FMT, len(payload), int(ts_sec), int(ts_usec))
            self._sock.sendall(header + payload)
        except Exception:
            self._close_socket()

    def _connect_socket(self, force):
        if self._sock:
            return
        now = time.time()
        if not force and (now - self._last_reconnect) < 1.0:
            return
        self._last_reconnect = now
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(1.0)
            sock.connect((self.MAC_IP, int(self.VIDEO_PORT)))
            self._sock = sock
            self.logger.info("VideoBridge connected %s:%s" % (self.MAC_IP, self.VIDEO_PORT))
        except Exception:
            self._sock = None

    def _close_socket(self):
        if self._sock:
            try:
                self._sock.close()
            except Exception:
                pass
        self._sock = None
              ]]></content></script>
