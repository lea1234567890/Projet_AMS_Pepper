            <Box name="AudioBridge" id="1" localization="8" tooltip="Pepper audio -> backend TCP" x="280" y="260">
              <bitmap>media/images/box/box-python-script.png</bitmap>
              <script language="4"><content><![CDATA[
import socket
import struct
import time

class MyClass(GeneratedClass):
    MAC_IP = "192.168.1.50"
    AUDIO_PORT = 5555
    AUDIO_SAMPLE_RATE = 16000
    AUDIO_CHANNEL_FLAG = 3
    AUDIO_DEINTERLEAVE = 0

    FRAME_HEADER_FMT = "<III"
    FRAME_HEADER_SIZE = struct.calcsize(FRAME_HEADER_FMT)

    def __init__(self):
        GeneratedClass.__init__(self)
        self._running = False
        self._audio_service = None
        self._sock = None
        self._last_reconnect = 0.0

    def onLoad(self):
        try:
            self._audio_service = self.session().service("ALAudioDevice")
        except Exception as e:
            self.logger.error("AudioBridge init error: %s" % str(e))

    def onUnload(self):
        self._stop_audio()

    def onInput_onStart(self):
        if self._running:
            return
        self._running = True
        self._connect_socket(True)
        self._start_audio()

    def onInput_onStop(self):
        self._stop_audio()
        self._close_socket()
        self._running = False
        self.onStopped()

    def _start_audio(self):
        if not self._audio_service:
            self.logger.error("AudioBridge: ALAudioDevice indisponible")
            return
        try:
            self._audio_service.setClientPreferences(
                self.getName(),
                int(self.AUDIO_SAMPLE_RATE),
                int(self.AUDIO_CHANNEL_FLAG),
                int(self.AUDIO_DEINTERLEAVE),
            )
            self._audio_service.subscribe(self.getName())
            self.logger.info("AudioBridge subscribed")
        except Exception as e:
            self.logger.error("AudioBridge subscribe error: %s" % str(e))

    def _stop_audio(self):
        try:
            if self._audio_service:
                self._audio_service.unsubscribe(self.getName())
        except Exception:
            pass

    def processRemote(self, nbOfChannels, nbrOfSamplesByChannel, aTimeStamp, buffer):
        if not self._running or not buffer:
            return

        try:
            if aTimeStamp and len(aTimeStamp) >= 2:
                ts_sec = int(aTimeStamp[0])
                ts_usec = int(aTimeStamp[1])
            else:
                now = time.time()
                ts_sec = int(now)
                ts_usec = int((now - ts_sec) * 1000000)
        except Exception:
            now = time.time()
            ts_sec = int(now)
            ts_usec = int((now - ts_sec) * 1000000)

        self._send_frame(buffer, ts_sec, ts_usec)

    def _send_frame(self, payload, ts_sec, ts_usec):
        if not payload:
            return
        try:
            self._connect_socket(False)
            if not self._sock:
                return
            header = struct.pack(self.FRAME_HEADER_FMT, len(payload), int(ts_sec), int(ts_usec))
            self._sock.sendall(header + payload)
        except Exception:
            self._close_socket()

    def _connect_socket(self, force):
        if self._sock:
            return
        now = time.time()
        if not force and (now - self._last_reconnect) < 1.0:
            return
        self._last_reconnect = now
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(1.0)
            sock.connect((self.MAC_IP, int(self.AUDIO_PORT)))
            self._sock = sock
            self.logger.info("AudioBridge connected %s:%s" % (self.MAC_IP, self.AUDIO_PORT))
        except Exception:
            self._sock = None

    def _close_socket(self):
        if self._sock:
            try:
                self._sock.close()
            except Exception:
                pass
        self._sock = None
              ]]></content></script>
              <Input name="onLoad" type="1" type_size="1" nature="0" inner="1" id="1" />
              <Input name="onStart" type="1" type_size="1" nature="2" inner="0" id="2" />
              <Input name="onStop" type="1" type_size="1" nature="3" inner="0" id="3" />
              <Output name="onStopped" type="1" type_size="1" nature="1" inner="0" id="4" />
