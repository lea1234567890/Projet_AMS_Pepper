              <Input name="onStart" type="1" type_size="1" nature="2" inner="0" id="2" />
              <Input name="onStop" type="1" type_size="1" nature="3" inner="0" id="3" />
              <Output name="onStopped" type="1" type_size="1" nature="1" inner="0" id="4" />
            </Box>

            <Box name="TTSControl" id="3" localization="8" tooltip="Backend TTS commands -> Pepper TTS" x="960" y="260">
              <bitmap>media/images/box/box-python-script.png</bitmap>
              <script language="4"><content><![CDATA[
import socket
import struct
import threading

class MyClass(GeneratedClass):
    CONTROL_PORT = 5558
    FRAME_HEADER_FMT = "<III"
    FRAME_HEADER_SIZE = struct.calcsize(FRAME_HEADER_FMT)
    CONTROL_PREFIX = "TTS:"

    def __init__(self):
        GeneratedClass.__init__(self)
        self._running = False
        self._tts_service = None
        self._thread = None
        self._server = None

    def onLoad(self):
        try:
            self._tts_service = self.session().service("ALTextToSpeech")
        except Exception as e:
            self.logger.error("TTSControl init error: %s" % str(e))

    def onUnload(self):
        self._stop_server()

    def onInput_onStart(self):
        if self._running:
            return
        self._running = True
        self._thread = threading.Thread(target=self._loop)
        self._thread.daemon = True
        self._thread.start()
        self.logger.info("TTSControl started")

    def onInput_onStop(self):
        self._stop_server()
        self._running = False
        self.onStopped()

    def _loop(self):
        try:
            srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            srv.bind(("0.0.0.0", int(self.CONTROL_PORT)))
            srv.listen(1)
            srv.settimeout(1.0)
            self._server = srv
        except Exception as e:
            self.logger.error("TTSControl server error: %s" % str(e))
            self._server = None
            return

        while self._running:
            try:
                conn, _addr = self._server.accept()
            except socket.timeout:
                continue
            except Exception:
                break

            try:
                while self._running:
                    payload = self._recv_typed_frame(conn)
                    if payload is None:
                        break
                    self._handle_payload(payload)
            except Exception:
                pass
            finally:
                try:
                    conn.close()
                except Exception:
                    pass

        self._stop_server()

    def _recv_typed_frame(self, conn):
        header = self._recv_exact(conn, self.FRAME_HEADER_SIZE)
        if not header:
            return None
        size, _ts_sec, _ts_usec = struct.unpack(self.FRAME_HEADER_FMT, header)
        if size <= 0:
            return None
        return self._recv_exact(conn, int(size))

    def _recv_exact(self, conn, size):
        data = ""
        while len(data) < size:
            chunk = conn.recv(size - len(data))
            if not chunk:
                return None
            data += chunk
        return data

    def _handle_payload(self, payload):
        if not payload:
            return
        try:
            prefix = self.CONTROL_PREFIX
            if payload.startswith(prefix):
                text = payload[len(prefix):]
                if text and self._tts_service:
                    self._tts_service.say(str(text))
        except Exception as e:
            self.logger.error("TTSControl payload error: %s" % str(e))

    def _stop_server(self):
        if self._server:
            try:
                self._server.close()
            except Exception:
                pass
        self._server = None
        if self._thread and self._thread.is_alive():
            self._thread.join(1.5)
        self._thread = None
              ]]></content></script>
